    const w = ring.offsetWidth;
    const radius = Math.round((w / 2) / Math.tan(Math.PI / N) * 1.18);
    ring.dataset.radius = radius;
    cards.forEach((c, i) => { c.style.transform = `rotateY(${i * step}deg) translateZ(${radius}px)`; });
  }

  const ringSection = $('.sr-ring-section');
  function ringProgress() {
    const r = ringSection.getBoundingClientRect();
    return clamp(-r.top / (r.height - innerHeight));
  }
  function goTo(i) {
    const top = ringSection.offsetTop + (i / (N - 1)) * (ringSection.offsetHeight - innerHeight);
    scrollTo({ top: top + 2, behavior: reduce ? 'auto' : 'smooth' });
  }
  $$('[data-ring]').forEach((b) => b.addEventListener('click', () => {
    const cur = Math.round(ringProgress() * (N - 1));
    goTo(clamp(cur + Number(b.dataset.ring), 0, N - 1));
  }));

  // ---------- Modal ----------
  const modal = $('.sr-modal');
  function openModal(i) {
    const t = TEMPLES[i];
    $('.sr-modal-art').innerHTML = artSvg(t);
    $('.sr-m-kicker').textContent = t.kicker;
    $('.sr-m-name').textContent = t.name;
    $('.sr-m-km').textContent = t.km;
    $('.sr-m-meta').innerHTML = t.meta.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join('');
    $('.sr-m-text').textContent = t.text;
    $('.sr-m-facts').innerHTML = t.facts.map((f) => `<li>${f}</li>`).join('');
    $('.sr-m-tip').textContent = t.tip;
    modal.showModal();
  }
  $('.sr-modal-close').addEventListener('click', () => modal.close());
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  // ---------- Timeline (horizontal pinned scroll) ----------
  const hSection = $('.sr-h-section');
  const hTrack = $('.sr-h-track');
  function sizeTimeline() {
    const extra = Math.max(0, hTrack.scrollWidth - innerWidth + 40);
    hSection.style.height = `${innerHeight + extra}px`;
    hSection.dataset.extra = extra;
  }

  // ---------- Hero parallax ----------
  const layers = $$('[data-depth]');
  let mx = 0, my = 0;
  addEventListener('pointermove', (e) => {
    mx = e.clientX / innerWidth - 0.5;
    my = e.clientY / innerHeight - 0.5;
  }, { passive: true });

  // ---------- Counters ----------
  const counters = $$('[data-count]');
  const io = new IntersectionObserver((entries) => entries.forEach((en) => {
    if (!en.isIntersecting) return;
    const el = en.target; io.unobserve(el);
    const end = Number(el.dataset.count), pre = el.dataset.prefix || '', suf = el.dataset.suffix || '';
    const fmt = (n) => (end > 2100 ? n.toLocaleString('en-US') : String(n));
    if (reduce) { el.textContent = pre + fmt(end) + suf; return; }
    const t0 = performance.now();
    const tick = (now) => {
      const p = clamp((now - t0) / 1600);
      el.textContent = pre + fmt(Math.round(end * (1 - Math.pow(1 - p, 3)))) + suf;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }), { threshold: 0.5 });
  counters.forEach((c) => io.observe(c));

  // ---------- Main animation loop ----------
  const bar = $('.sr-progress span');
  const tilts = $$('.tilt-in');
  const hero = $('.sr-hero');
  function frame() {
    const y = scrollY, vh = innerHeight;
    bar.style.transform = `scaleX(${clamp(y / (document.documentElement.scrollHeight - vh))})`;

    // hero layers
    if (y < hero.offsetHeight * 1.2) {
      const hp = clamp(y / hero.offsetHeight);
      layers.forEach((l) => {
        const d = Number(l.dataset.depth);
        if (l.classList.contains('sr-hero-copy')) {
          l.style.transform = `translate3d(${mx * -20}px, ${y * 0.45}px, 0) scale(${1 + hp * 0.25})`;
          l.style.opacity = String(1 - hp * 1.6);
        } else {
          l.style.transform = `translate3d(${mx * d * -60}px, ${y * (1 - d) * 0.5 + my * d * -20}px, 0) scale(${1 + hp * d * 0.35})`;
        }
      });
    }

    // ring rotation
    const rp = ringProgress();
    const angle = -rp * step * (N - 1);
    const tiltX = reduce ? 0 : -8 + Math.sin(rp * Math.PI) * 4;
    ring.style.transform = `translateZ(-${ring.dataset.radius || 300}px) rotateX(${tiltX}deg) rotateY(${angle}deg)`;
    const active = Math.round(rp * (N - 1));
    cards.forEach((c, i) => c.classList.toggle('is-active', i === active));
    dotBtns.forEach((d, i) => d.classList.toggle('on', i === active));

    // timeline
    const hr = hSection.getBoundingClientRect();
    const hp = clamp(-hr.top / (hr.height - vh || 1));
    hTrack.style.transform = `translate3d(${-hp * Number(hSection.dataset.extra || 0)}px,0,0)`;

    // 3D tilt-in reveal for elements entering the screen
    if (!reduce) tilts.forEach((el) => {
      const top = el.getBoundingClientRect().top;
      const t = clamp((vh - top) / (vh * 0.55));
      el.style.transform = `perspective(1100px) rotateX(${(1 - t) * 28}deg) translate3d(0, ${(1 - t) * 70}px, ${(1 - t) * -120}px)`;
      el.style.opacity = String(0.15 + t * 0.85);
    });
    requestAnimationFrame(frame);
  }

  // ---------- Card hover tilt ----------
  $$('.sr-stat, .sr-era, .sr-pass').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5, yy = (e.clientY - r.top) / r.height - 0.5;
      el.style.translate = '0 -4px';
      el.style.background = `radial-gradient(circle at ${(x + 0.5) * 100}% ${(yy + 0.5) * 100}%, rgba(62,230,193,.22), rgba(255,255,255,.03) 60%)`;
    });
    el.addEventListener('pointerleave', () => { el.style.translate = ''; el.style.background = ''; });
  });

  // ---------- Flip cards (tap on phones) ----------
  $$('.sr-flip').forEach((f) => f.addEventListener('click', () => f.classList.toggle('flipped')));

  // ---------- Lake slider ----------
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const AREA = [9000, 6000, 3500, 2700, 2500, 3500, 6500, 11000, 15000, 16000, 14000, 11500];
  const slider = $('#month');
  function updateLake() {
    const m = Number(slider.value), a = AREA[m];
    const s = 0.35 + (a - 2500) / (16000 - 2500) * 0.65;
    $('.sr-lake-shape').style.transform = `scale(${s})`;
    $('.sr-houses').style.transform = `translateY(${(1 - s) * 30}px)`;
    $('[data-lake="month"]').textContent = MONTHS[m];
    $('[data-lake="area"]').textContent = `${a.toLocaleString('en-US')} km²`;
    $('[data-lake="season"]').textContent = m >= 5 && m <= 9 ? 'Rainy' : 'Dry';
  }
  slider.addEventListener('input', updateLake);

  // ---------- Season tabs ----------
  const SEASONS = [
    ['20–31°C', 'November – February', 'The most popular time. Clear sunrises over Angkor Wat, cool mornings and blue skies. Book rooms early.'],
    ['up to 38°C', 'March – May', 'Very hot and dry. Visit temples at dawn, rest at midday, and celebrate Khmer New Year in mid-April.'],
    ['24–33°C', 'June – October', 'The green season: short afternoon rain, full moats, lush jungle, strong waterfalls and fewer crowds.'],
  ];
  const tabs = $$('[data-season]');
  const body = $('.sr-season-body');
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    body.classList.add('swap');
    setTimeout(() => {
      const [temp, title, text] = SEASONS[Number(t.dataset.season)];
      $('.sr-season-temp').textContent = temp;
      $('.sr-season-title').textContent = title;
      $('.sr-season-text').textContent = text;
      body.classList.remove('swap');
    }, 250);
  }));

  // ---------- Fireflies ----------
  const cv = $('.sr-fireflies'), ctx = cv.getContext('2d');
  let flies = [];
  function sizeCanvas() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    cv.width = innerWidth * dpr; cv.height = innerHeight * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = innerWidth < 700 ? 22 : 45;
    flies = Array.from({ length: n }, () => ({ x: Math.random() * innerWidth, y: Math.random() * innerHeight, r: 1 + Math.random() * 2, a: Math.random() * 6.28, s: 0.2 + Math.random() * 0.5, h: Math.random() < 0.7 ? '180,244,97' : '255,210,122' }));
  }
  function drawFlies(now) {
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    flies.forEach((f) => {
      f.a += 0.01; f.x += Math.cos(f.a) * f.s; f.y += Math.sin(f.a * 0.7) * f.s - 0.1;
      if (f.y < -10) f.y = innerHeight + 10; if (f.x < -10) f.x = innerWidth + 10; if (f.x > innerWidth + 10) f.x = -10;
      const glow = 0.4 + 0.6 * Math.abs(Math.sin(now / 900 + f.a * 3));
      ctx.beginPath(); ctx.fillStyle = `rgba(${f.h},${glow})`; ctx.shadowBlur = 12; ctx.shadowColor = `rgba(${f.h},1)`;
      ctx.arc(f.x, f.y, f.r, 0, 6.28); ctx.fill();
    });
    requestAnimationFrame(drawFlies);
  }

  function onResize() { placeCards(); sizeTimeline(); sizeCanvas(); }
  addEventListener('resize', onResize);
  onResize();
  updateLake();
  requestAnimationFrame(frame);
  if (!reduce) requestAnimationFrame(drawFlies);
})();
</script>
<!-- PAGE:END -->
</Base>
