---
// The homepage: an interactive 3D scroll journey through Siem Reap.
// Each <section> below is one "chapter" of the page — ask the AI to add,
// remove, or reorder them. Temple details live in the TEMPLES list in the
// <script> at the bottom. The styles for this page are in the <style> block.
import Base from '../layouts/Base.astro';
---

<Base>
<!-- PAGE:START -->
<div class="sr">
  <div class="sr-progress" aria-hidden="true"><span></span></div>
  <canvas class="sr-fireflies" aria-hidden="true"></canvas>

  <!-- NAV -->
  <header class="sr-nav">
    <a href="#top" class="sr-logo">
      <span class="sr-logo-mark" aria-hidden="true"></span>
      Siem Reap <span lang="km">សៀមរាប</span>
    </a>
    <nav>
      <a href="#wonders">Wonders</a>
      <a href="#time">Timeline</a>
      <a href="#lake">Tonle Sap</a>
      <a href="#taste">Taste</a>
      <a href="#plan" class="sr-nav-cta">Plan a visit</a>
    </nav>
  </header>

  <!-- HERO: layered 3D scene that moves with scroll and mouse -->
  <section id="top" class="sr-hero">
    <div class="sr-scene">
      <div class="sr-sun" data-depth="0.15"></div>
      <svg class="sr-layer" data-depth="0.25" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <path d="M0 640 C200 560 380 600 560 570 C760 535 900 600 1100 560 C1300 520 1450 585 1600 560 L1600 900 L0 900Z" fill="url(#hill)" opacity=".55"/>
        <defs>
          <linearGradient id="hill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3ee6c1" stop-opacity=".35"/><stop offset="1" stop-color="#062a22"/></linearGradient>
          <linearGradient id="temple" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0e3b31"/><stop offset="1" stop-color="#03130f"/></linearGradient>
        </defs>
      </svg>
      <svg class="sr-layer sr-temple" data-depth="0.45" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="url(#temple)" transform="translate(800 720) scale(.72) translate(-800 -720)">
          <!-- terraces -->
          <rect x="420" y="640" width="760" height="40" rx="2"/>
          <rect x="480" y="600" width="640" height="44"/>
          <rect x="560" y="560" width="480" height="44"/>
          <!-- five lotus-bud towers (Angkor Wat) -->
          <path d="M560 604 L572 470 Q600 380 628 470 L640 604Z"/>
          <path d="M960 604 L972 470 Q1000 380 1028 470 L1040 604Z"/>
          <path d="M640 564 L654 420 Q690 320 726 420 L740 564Z"/>
          <path d="M860 564 L874 420 Q910 320 946 420 L960 564Z"/>
          <path d="M740 564 L756 360 Q800 220 844 360 L860 564Z"/>
          <rect x="796" y="200" width="8" height="40"/>
          <rect x="686" y="300" width="8" height="30"/>
          <rect x="906" y="300" width="8" height="30"/>
          <!-- causeway -->
          <rect x="770" y="680" width="60" height="40"/>
        </g>
      </svg>
      <svg class="sr-layer sr-reflect" data-depth="0.45" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <rect x="0" y="720" width="1600" height="180" fill="url(#water)"/>
        <defs><linearGradient id="water" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff9a5a" stop-opacity=".35"/><stop offset=".5" stop-color="#3ee6c1" stop-opacity=".15"/><stop offset="1" stop-color="#03130f"/></linearGradient></defs>
        <g fill="#062a22" opacity=".45" transform="translate(800 720) scale(.72 -.72) translate(-800 -720)">
          <path d="M740 724 L756 520 Q800 380 844 520 L860 724Z"/>
          <path d="M640 724 L654 580 Q690 480 726 580 L740 724Z"/>
          <path d="M860 724 L874 580 Q910 480 946 580 L960 724Z"/>
        </g>
      </svg>
      <svg class="sr-layer" data-depth="0.8" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="#020c09">
          <!-- sugar palms, the tree of Cambodia -->
          <g transform="translate(150 260)"><rect x="-6" y="0" width="12" height="640"/><g class="sr-palm"><ellipse cx="0" cy="0" rx="90" ry="22"/><ellipse cx="0" cy="0" rx="90" ry="22" transform="rotate(40)"/><ellipse cx="0" cy="0" rx="90" ry="22" transform="rotate(-40)"/><ellipse cx="0" cy="0" rx="80" ry="20" transform="rotate(80)"/></g></g>
          <g transform="translate(300 380) scale(.75)"><rect x="-6" y="0" width="12" height="700"/><g class="sr-palm"><ellipse cx="0" cy="0" rx="90" ry="22"/><ellipse cx="0" cy="0" rx="90" ry="22" transform="rotate(40)"/><ellipse cx="0" cy="0" rx="90" ry="22" transform="rotate(-40)"/><ellipse cx="0" cy="0" rx="80" ry="20" transform="rotate(80)"/></g></g>
          <g transform="translate(1420 300) scale(.9)"><rect x="-6" y="0" width="12" height="700"/><g class="sr-palm"><ellipse cx="0" cy="0" rx="90" ry="22"/><ellipse cx="0" cy="0" rx="90" ry="22" transform="rotate(40)"/><ellipse cx="0" cy="0" rx="90" ry="22" transform="rotate(-40)"/><ellipse cx="0" cy="0" rx="80" ry="20" transform="rotate(80)"/></g></g>
          <path d="M0 860 Q200 800 420 850 T900 840 T1600 830 L1600 900 L0 900Z"/>
        </g>
      </svg>
    </div>

    <div class="sr-hero-copy" data-depth="-0.3">
      <p class="sr-eyebrow">Cambodia · Gateway to Angkor</p>
      <h1>
        <span class="sr-grad">Siem Reap</span>
        <span class="sr-hero-km" lang="km">សៀមរាប</span>
      </h1>
      <p class="sr-lede">Where the jungle keeps the temples. Scroll to travel through a thousand years of stone, water and green.</p>
      <div class="sr-hero-cta">
        <a href="#wonders" class="sr-btn">Start the journey ↓</a>
        <a href="#plan" class="sr-btn sr-btn-ghost">Plan a visit</a>
      </div>
    </div>
    <div class="sr-scroll-hint" aria-hidden="true"><span></span></div>
  </section>

  <!-- STATS -->
  <section class="sr-stats">
    <div class="sr-wrap sr-stat-grid">
      <div class="sr-glass sr-stat tilt-in"><b data-count="1992">0</b><span>Angkor named a UNESCO World Heritage Site</span></div>
      <div class="sr-glass sr-stat tilt-in"><b data-count="400" data-suffix=" km²">0</b><span>Angkor Archaeological Park</span></div>
      <div class="sr-glass sr-stat tilt-in"><b data-count="802" data-prefix="AD ">0</b><span>Khmer Empire founded on Phnom Kulen</span></div>
      <div class="sr-glass sr-stat tilt-in"><b data-count="16000" data-suffix=" km²">0</b><span>Tonle Sap lake at its rainy-season peak</span></div>
    </div>
  </section>

  <!-- WONDERS: 3D ring carousel driven by scroll -->
  <section id="wonders" class="sr-ring-section">
    <div class="sr-sticky">
      <div class="sr-wrap sr-section-head">
        <p class="sr-eyebrow">Chapter 1 · Wonders</p>
        <h2>Six places, <span class="sr-grad">one circle of stone</span></h2>
        <p class="sr-muted">Keep scrolling to turn the ring. Tap a card to open its story.</p>
      </div>
      <div class="sr-stage">
        <div class="sr-ring" aria-live="polite"></div>
      </div>
      <div class="sr-ring-ui">
        <button class="sr-round" data-ring="-1" aria-label="Previous place">←</button>
        <div class="sr-ring-dots"></div>
        <button class="sr-round" data-ring="1" aria-label="Next place">→</button>
      </div>
    </div>
  </section>

  <!-- TIMELINE: horizontal track pinned while you scroll -->
  <section id="time" class="sr-h-section">
    <div class="sr-sticky">
      <div class="sr-wrap sr-section-head">
        <p class="sr-eyebrow">Chapter 2 · Time</p>
        <h2>Twelve centuries <span class="sr-grad">in one scroll</span></h2>
      </div>
      <div class="sr-h-track">
        <article class="sr-glass sr-era"><b>802</b><h3>A god-king is crowned</h3><p>Jayavarman II declares himself universal ruler on Phnom Kulen, the sacred mountain. The Khmer Empire begins.</p></article>
        <article class="sr-glass sr-era"><b>889</b><h3>The first capital at Angkor</h3><p>Yasovarman I builds Yasodharapura around the hill temple of Phnom Bakheng, still a famous sunset spot.</p></article>
        <article class="sr-glass sr-era"><b>11th c.</b><h3>Engineering water</h3><p>The West Baray, a reservoir about 8 km long, is dug. Angkor becomes a city run on canals and moats.</p></article>
        <article class="sr-glass sr-era"><b>1113–1150</b><h3>Angkor Wat rises</h3><p>Suryavarman II builds the largest religious monument on Earth, dedicated to the Hindu god Vishnu.</p></article>
        <article class="sr-glass sr-era"><b>1181–1218</b><h3>The great builder</h3><p>Jayavarman VII builds Angkor Thom, the Bayon, Ta Prohm, hospitals and roads across the empire.</p></article>
        <article class="sr-glass sr-era"><b>1431</b><h3>The court moves south</h3><p>After wars with Ayutthaya, the capital shifts toward Phnom Penh. Monks keep Angkor Wat alive.</p></article>
        <article class="sr-glass sr-era"><b>1860</b><h3>Told to the world</h3><p>French explorer Henri Mouhot’s journals bring Angkor to wide attention in Europe.</p></article>
        <article class="sr-glass sr-era"><b>1907</b><h3>Siem Reap returns</h3><p>A Franco-Siamese treaty returns Siem Reap province to Cambodia.</p></article>
        <article class="sr-glass sr-era"><b>1992</b><h3>World Heritage</h3><p>UNESCO lists Angkor. Restoration teams from many countries begin work.</p></article>
        <article class="sr-glass sr-era"><b>2023</b><h3>A new gateway</h3><p>Siem Reap–Angkor International Airport opens, welcoming a new generation of visitors.</p></article>
      </div>
    </div>
  </section>

  <!-- TONLE SAP: interactive lake slider -->
  <section id="lake" class="sr-wrap sr-lake">
    <div class="sr-lake-copy tilt-in">
      <p class="sr-eyebrow">Chapter 3 · Water</p>
      <h2>The lake that <span class="sr-grad">breathes</span></h2>
      <p class="sr-muted">Every rainy season the Mekong pushes so much water upstream that the Tonle Sap River <b>reverses direction</b>. The lake swells to about six times its size, flooding forests and feeding one of the world’s richest inland fisheries.</p>
      <label class="sr-slider-label" for="month">Drag through the year</label>
      <input id="month" type="range" min="0" max="11" value="3" />
      <div class="sr-months" aria-hidden="true"><span>Jan</span><span>Apr</span><span>Jul</span><span>Oct</span><span>Dec</span></div>
      <div class="sr-lake-read">
        <div><small>Month</small><b data-lake="month">April</b></div>
        <div><small>Lake area*</small><b data-lake="area">2,700 km²</b></div>
        <div><small>Season</small><b data-lake="season">Dry</b></div>
      </div>
      <p class="sr-note">*Approximate. The lake ranges from about 2,500 km² to 16,000 km², and from about 1 m to 9 m deep.</p>
    </div>
    <div class="sr-lake-viz sr-glass tilt-in" aria-hidden="true">
      <svg viewBox="0 0 400 400">
        <defs>
          <radialGradient id="lakeG" cx=".4" cy=".35" r=".8"><stop offset="0" stop-color="#7ef9de"/><stop offset=".6" stop-color="#1fb5a0"/><stop offset="1" stop-color="#0b5d63"/></radialGradient>
          <filter id="blur"><feGaussianBlur stdDeviation="2"/></filter>
        </defs>
        <g class="sr-lake-shape" style="transform-origin:200px 200px">
          <path d="M120 90 C200 40 320 70 340 160 C360 250 300 330 210 340 C120 350 60 290 60 210 C60 150 80 115 120 90Z" fill="url(#lakeG)" filter="url(#blur)"/>
          <path class="sr-wave" d="M90 200 Q130 185 170 200 T250 200 T330 200" stroke="#ffffff55" stroke-width="3" fill="none"/>
          <path class="sr-wave sr-wave2" d="M100 240 Q140 225 180 240 T260 240 T320 240" stroke="#ffffff33" stroke-width="3" fill="none"/>
        </g>
        <!-- floating village houses -->
        <g class="sr-houses" fill="#ffd27a">
          <path d="M160 200 l12 -12 l12 12 v14 h-24z"/><path d="M200 214 l12 -12 l12 12 v14 h-24z"/><path d="M236 196 l12 -12 l12 12 v14 h-24z"/>
        </g>
      </svg>
      <p class="sr-lake-tag">Floating & stilt villages: Kampong Phluk, Chong Kneas, Kampong Khleang</p>
    </div>
  </section>

  <!-- TASTE: 3D flip cards -->
  <section id="taste" class="sr-wrap sr-taste">
    <div class="sr-section-head tilt-in">
      <p class="sr-eyebrow">Chapter 4 · Taste</p>
      <h2>Eat like <span class="sr-grad">a local</span></h2>
      <p class="sr-muted">Hover or tap a card to flip it.</p>
    </div>
    <div class="sr-flip-grid">
      <button class="sr-flip tilt-in"><span class="sr-flip-in"><span class="sr-front"><i>🐟</i><b>Fish Amok</b><em lang="km">អាម៉ុក</em></span><span class="sr-back">Fish steamed in banana leaf with coconut milk and <i>kroeung</i>, a fresh paste of lemongrass, turmeric and galangal.</span></span></button>
      <button class="sr-flip tilt-in"><span class="sr-flip-in"><span class="sr-front"><i>🍜</i><b>Num Banh Chok</b><em lang="km">នំបញ្ចុក</em></span><span class="sr-back">Fresh rice noodles with green fish curry and raw herbs. The classic Khmer breakfast, sold from baskets at dawn.</span></span></button>
      <button class="sr-flip tilt-in"><span class="sr-flip-in"><span class="sr-front"><i>🥩</i><b>Lok Lak</b><em lang="km">ឡុកឡាក់</em></span><span class="sr-back">Stir-fried beef cubes over lettuce and tomato, dipped in lime juice with Kampot black pepper.</span></span></button>
      <button class="sr-flip tilt-in"><span class="sr-flip-in"><span class="sr-front"><i>🎋</i><b>Kralan</b><em lang="km">ក្រឡាន</em></span><span class="sr-back">Sticky rice, beans and coconut roasted inside bamboo tubes. Look for roadside stalls on the way to Banteay Srei.</span></span></button>
      <button class="sr-flip tilt-in"><span class="sr-flip-in"><span class="sr-front"><i>🍛</i><b>Khmer Red Curry</b><em lang="km">ការី</em></span><span class="sr-back">Mild coconut curry with sweet potato and chicken, often eaten with baguette. Made for weddings and festivals.</span></span></button>
      <button class="sr-flip tilt-in"><span class="sr-flip-in"><span class="sr-front"><i>🥥</i><b>Nom Krok</b><em lang="km">នំគ្រក</em></span><span class="sr-back">Little coconut-rice cakes, crispy outside and soft inside, cooked in a clay pan over charcoal.</span></span></button>
    </div>
  </section>

  <!-- PLAN -->
  <section id="plan" class="sr-wrap sr-plan">
    <div class="sr-section-head tilt-in">
      <p class="sr-eyebrow">Chapter 5 · Go</p>
      <h2>Plan your <span class="sr-grad">visit</span></h2>
    </div>
    <div class="sr-plan-grid">
      <div class="sr-glass sr-season tilt-in">
        <div class="sr-tabs" role="tablist">
          <button role="tab" aria-selected="true" data-season="0">Cool & dry</button>
          <button role="tab" aria-selected="false" data-season="1">Hot</button>
          <button role="tab" aria-selected="false" data-season="2">Green</button>
        </div>
        <div class="sr-season-body">
          <b class="sr-season-temp">20–31°C</b>
          <h3 class="sr-season-title">November – February</h3>
          <p class="sr-season-text">The most popular time. Clear sunrises over Angkor Wat, cool mornings and blue skies. Book rooms early.</p>
        </div>
      </div>
      <div class="sr-passes">
        <div class="sr-glass sr-pass tilt-in"><small>Angkor Pass</small><b>$37</b><span>1 day</span></div>
        <div class="sr-glass sr-pass sr-pass-hot tilt-in"><small>Angkor Pass</small><b>$62</b><span>3 days · use within 10 days</span></div>
        <div class="sr-glass sr-pass tilt-in"><small>Angkor Pass</small><b>$72</b><span>7 days · use within 1 month</span></div>
        <p class="sr-note">Prices may change. Buy only at the official Angkor ticket office. US dollars and Cambodian riel are both used in town.</p>
      </div>
      <ul class="sr-tips tilt-in">
        <li><b>🌅 Sunrise</b> Arrive at Angkor Wat’s reflecting pool by 5:00.</li>
        <li><b>👕 Dress</b> Cover shoulders and knees to climb the upper temples.</li>
        <li><b>🛺 Get around</b> Hire a tuk-tuk for the day, or cycle the small circuit.</li>
        <li><b>🎪 Night</b> Pub Street, the Night Market, and Phare, the Cambodian Circus.</li>
      </ul>
    </div>
  </section>

  <footer class="sr-footer">
    <p class="sr-grad sr-footer-big" lang="km">សូមស្វាគមន៍</p>
    <p>Welcome to Siem Reap. A demo website made by talking to AI.</p>
  </footer>

  <!-- Detail popup for the ring cards -->
  <dialog class="sr-modal">
    <div class="sr-modal-art" aria-hidden="true"></div>
    <div class="sr-modal-body">
      <button class="sr-modal-close" aria-label="Close">✕</button>
      <p class="sr-eyebrow sr-m-kicker"></p>
      <h3 class="sr-m-name"></h3>
      <p class="sr-m-km" lang="km"></p>
      <dl class="sr-m-meta"></dl>
      <p class="sr-m-text"></p>
      <ul class="sr-m-facts"></ul>
      <p class="sr-m-tip"></p>
    </div>
  </dialog>
</div>

<style is:global>
  :root {
    --sr-bg: #03130f;
    --sr-deep: #062a22;
    --sr-mint: #3ee6c1;
    --sr-lime: #b4f461;
    --sr-gold: #ffb347;
    --sr-lotus: #ff7eb6;
    --sr-text: #eafff7;
    --sr-muted: #9cc7ba;
    --sr-glass: rgba(255, 255, 255, 0.06);
    --sr-line: rgba(180, 244, 97, 0.18);
  }
  html { background: var(--sr-bg); color: var(--sr-text); scroll-behavior: smooth; }
  body { background: var(--sr-bg); overflow-x: hidden; }
  .sr { font-family: "Inter Variable", "Inter", "Kantumruy Pro Variable", "Kantumruy Pro", system-ui, sans-serif; position: relative; }
  .sr h1, .sr h2, .sr h3, .sr-logo, .sr-stat b, .sr-era b, .sr-pass b { font-family: "Bricolage Grotesque Variable", "Bricolage Grotesque", "Kantumruy Pro Variable", "Kantumruy Pro", system-ui, sans-serif; }
  .sr [lang="km"] { font-family: "Kantumruy Pro Variable", "Kantumruy Pro", system-ui, sans-serif; }
  .sr-wrap { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 640px) { .sr-wrap { padding: 0 32px; } }

  .sr-grad {
    background: linear-gradient(100deg, var(--sr-lime), var(--sr-mint) 40%, var(--sr-gold) 75%, var(--sr-lotus));
    background-size: 200% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: sr-shimmer 8s ease-in-out infinite alternate;
  }
  @keyframes sr-shimmer { to { background-position: 100% 0; } }
  .sr-eyebrow { color: var(--sr-lime); font-weight: 600; letter-spacing: .14em; text-transform: uppercase; font-size: .78rem; }
  .sr-muted { color: var(--sr-muted); font-size: 1.08rem; line-height: 1.65; }
  .sr-note { color: var(--sr-muted); font-size: .82rem; opacity: .8; margin-top: 12px; }
  .sr h2 { font-size: clamp(2.1rem, 5.5vw, 4rem); line-height: 1.02; font-weight: 800; letter-spacing: -.02em; margin: 10px 0 14px; }
  .sr-section-head { text-align: center; max-width: 760px; margin: 0 auto; }
  .sr-glass {
    background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(255,255,255,.02));
    border: 1px solid var(--sr-line);
    border-radius: 24px;
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 20px 60px -20px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.08);
  }

  /* progress + fireflies */
  .sr-progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 60; }
  .sr-progress span { display: block; height: 100%; width: 100%; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, var(--sr-lime), var(--sr-mint), var(--sr-gold), var(--sr-lotus)); }
  .sr-fireflies { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }

  /* nav */
  .sr-nav { position: fixed; top: 12px; left: 50%; transform: translateX(-50%); z-index: 50; width: min(1100px, calc(100% - 24px)); display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 8px 8px 16px; border-radius: 999px; background: rgba(3, 19, 15, .55); border: 1px solid var(--sr-line); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .sr-logo { display: flex; align-items: center; gap: 8px; font-weight: 800; color: var(--sr-text); text-decoration: none; white-space: nowrap; }
  .sr-logo [lang="km"] { color: var(--sr-mint); font-weight: 500; font-size: .9em; }
  .sr-logo-mark { width: 22px; height: 22px; border-radius: 7px; background: conic-gradient(from 200deg, var(--sr-lime), var(--sr-mint), var(--sr-gold), var(--sr-lotus), var(--sr-lime)); box-shadow: 0 0 18px var(--sr-mint); }
  .sr-nav nav { display: flex; gap: 2px; }
  .sr-nav nav a { color: var(--sr-muted); text-decoration: none; font-size: .9rem; padding: 8px 12px; border-radius: 999px; transition: .25s; }
  .sr-nav nav a:hover { color: var(--sr-text); background: rgba(255,255,255,.06); }
  .sr-nav nav a:not(.sr-nav-cta) { display: none; }
  @media (min-width: 820px) { .sr-nav nav a:not(.sr-nav-cta) { display: inline-block; } }
  .sr .sr-nav-cta { color: var(--sr-bg) !important; background: linear-gradient(90deg, var(--sr-lime), var(--sr-mint)); font-weight: 700; }
  @media (max-width: 420px) { .sr-logo [lang="km"] { display: none; } }

  /* buttons */
  .sr-btn { display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 999px; font-weight: 700; text-decoration: none; color: var(--sr-bg); background: linear-gradient(90deg, var(--sr-lime), var(--sr-mint)); box-shadow: 0 10px 40px -10px var(--sr-mint); transition: transform .25s, box-shadow .25s; }
  .sr-btn:hover { transform: translateY(-3px); box-shadow: 0 16px 50px -10px var(--sr-mint); }
  .sr-btn-ghost { background: rgba(255,255,255,.06); color: var(--sr-text); border: 1px solid var(--sr-line); box-shadow: none; }
  .sr-round { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--sr-line); background: var(--sr-glass); color: var(--sr-text); font-size: 1.2rem; cursor: pointer; transition: .2s; }
  .sr-round:hover { background: var(--sr-mint); color: var(--sr-bg); }

  /* hero */
  .sr-hero { position: relative; height: 100vh; height: 100svh; min-height: 560px; overflow: hidden; perspective: 1000px;
